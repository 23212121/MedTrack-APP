# =============================================================================
# AWS_Application.properties.example
# Copy to AWS_Application.properties and fill in your own keys.
# Do not commit AWS_Application.properties (see .gitignore).
# =============================================================================

aws.s3.enabled=false

aws.s3.bucket=your-bucket-name
aws.s3.account-id=
aws.s3.access-point-name=
aws.s3.access-point-arn=
aws.s3.access-point-alias=
aws.s3.region=ap-south-1

aws.s3.access-key=
aws.s3.secret-key=

aws.s3.prefix=patient-documents
aws.s3.endpoint=
aws.s3.path-style-access=false

# Razorpay — copy to AWS_Application.properties (gitignored) or set as env vars
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Company Gmail SMTP. Gmail usually needs a 16-character App Password, not the login password.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your-company@gmail.com
# MAIL_PASS=
# MAIL_FROM=your-company@gmail.com
# MAIL_NOTIFY_TO=ops-inbox@example.com
# MAIL_CONTACT_TO=ops-inbox@example.com
